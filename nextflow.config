debug = true

params.ec_kaptive_db = "assets/EC-K-typing_group2and3_v3.0.0.gbk"

apptainer {
	enabled = true
	envWhitelist = 'JAVA_TOOL_OPTIONS'
	cacheDir = 'work/apptainer'
}

wave {
    enabled = true
    strategy = ['conda']
    freeze = true
}

process {
	withLabel: process_1 {
		cpus = 1
	}
		withLabel: process_4 {
		cpus = 4
	}
	withLabel: process_8 {
		cpus = 8
	}
}
executor {
	cpus = 64
	memory = '250 GB'
}

env {
	JAVA_TOOL_OPTIONS = '-XX:+PerfDisableSharedMem'
}

